{
	"name": "@membership-connector-app/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./types": {
			"default": "./src/types.ts"
		},
		"./schema/*": {
			"default": "./src/schema/*.ts"
		}
	},
	"scripts": {
		"db:push": "drizzle-kit push",
		"db:generate": "node ./scripts/generate-migration.mjs",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"db:rollback": "node ./scripts/rollback-migration.mjs",
		"db:seed": "node ./scripts/seed.mjs",
		"db:start": "docker compose up -d",
		"db:watch": "docker compose up",
		"db:stop": "docker compose stop",
		"db:down": "docker compose down"
	},
	"dependencies": {
		"@better-auth/utils": "^0.4.0",
		"@membership-connector-app/env": "workspace:*",
		"@membership-connector-app/observability": "workspace:*",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.1",
		"pg": "^8.17.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@membership-connector-app/config": "workspace:*",
		"@types/pg": "^8.16.0",
		"drizzle-kit": "^0.31.8",
		"tsx": "^4.19.2",
		"typescript": "catalog:"
	}
}
